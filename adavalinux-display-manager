#!/bin/sh
set -eu

display=:0
while :; do
  Xorg "$display" vt1 -nolisten tcp &
  xorg_pid=$!
  trap 'kill "$xorg_pid" 2>/dev/null || true; exit 0' HUP INT TERM
  until [ -S /tmp/.X11-unix/X0 ]; do
    kill -0 "$xorg_pid" 2>/dev/null || exit 1
    sleep 1
  done
  DISPLAY="$display" /usr/bin/adavalinux-greeter || true
  kill "$xorg_pid" 2>/dev/null || true
  wait "$xorg_pid" 2>/dev/null || true
done
