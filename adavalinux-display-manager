#!/bin/sh
set -eu

display=:0
chown root:root /run /dev/null 2>/dev/null || true
chmod 755 /run 2>/dev/null || true
chmod 666 /dev/null 2>/dev/null || true
mkdir -p /dev/pts
if ! awk '$2=="/dev/pts" && $4 ~ /(^|,)ptmxmode=666(,|$)/{found=1} END{exit !found}' /proc/mounts 2>/dev/null; then
  if awk '$2=="/dev/pts"{found=1} END{exit !found}' /proc/mounts 2>/dev/null; then
    mount -o remount,gid=5,mode=620,ptmxmode=666 -t devpts devpts /dev/pts 2>/dev/null || true
  else
    mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts /dev/pts 2>/dev/null || true
  fi
fi
ln -sfn pts/ptmx /dev/ptmx 2>/dev/null || true
chmod 666 /dev/ptmx 2>/dev/null || true

if [ ! -S /run/udev/control ]; then
  mkdir -p /run /run/udev
  if [ -x /usr/lib/systemd/systemd-udevd ]; then
    /usr/lib/systemd/systemd-udevd --daemon || true
    [ -x /usr/bin/udevadm ] && /usr/bin/udevadm trigger --subsystem-match=input &
    [ -x /usr/bin/udevadm ] && /usr/bin/udevadm settle --timeout=5 >/dev/null 2>&1 &
  fi
fi

Xorg "$display" vt1 -nolisten tcp &
xorg_pid=$!

cleanup() {
  kill "$xorg_pid" 2>/dev/null || true
  wait "$xorg_pid" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

ready=0
attempt=0
while [ "$attempt" -lt 50 ]; do
  if DISPLAY="$display" /usr/bin/adavalinux-x-ready; then
    ready=1
    break
  fi
  if ! kill -0 "$xorg_pid" 2>/dev/null; then
    echo 'adavalinux-display-manager: Xorg failed to start' >&2
    exit 1
  fi
  attempt=$((attempt + 1))
  sleep 1
done

if [ "$ready" -ne 1 ]; then
  echo 'adavalinux-display-manager: Xorg failed to start' >&2
  exit 1
fi

DISPLAY="$display" /usr/bin/adavalinux-logon
